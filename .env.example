# QanunHub server configuration. Copy to .env and fill in the values from your Supabase project.

# --- Supabase -------------------------------------------------------------------------------------
# Project Settings -> API: the project URL and the publishable key (sb_publishable_..., or the legacy anon key).
# Both are public: the server hands them to the browser through /api/config.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Only if the project still signs access tokens with the legacy shared JWT secret (HS256).
# Projects on asymmetric JWT signing keys (the default for new projects) need nothing here: tokens are checked
# against https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json. Never expose this value to the browser.
SUPABASE_JWT_SECRET=

# Project Settings -> Database -> Connection string. The session pooler (port 5432) or a direct connection.
# With the transaction pooler (port 6543) also set DATABASE_PREPARE=false.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_PREPARE=true

# --- App ------------------------------------------------------------------------------------------
PORT=8080
# Public address of the web app (also add it to Supabase -> Authentication -> URL Configuration).
APP_ORIGIN=http://localhost:8080
# true when running behind a reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For.
TRUST_PROXY=false
# The account with this email becomes admin the first time it signs in.
ADMIN_EMAIL=admin@example.com
# Learners may change category once per 30 days (false = any time).
CATEGORY_CHANGE_LIMIT=true
# Set by the Docker image; uncomment only when running the server outside Docker.
# WEB_DIST=apps/web/dist                       # built web app served by the API server
# CONTENT_SEED=content/build/content.json      # imported on first start when the database has no content yet
