# QanunHub server configuration. Copy to .env and adjust.

# Postgres connection (docker-compose sets this for you).
DATABASE_URL=postgres://qanunhub:qanunhub@localhost:5432/qanunhub
PORT=8080

# Public address of the web app: used in email links and the CSRF origin check.
APP_ORIGIN=http://localhost:5173

# true behind HTTPS (production). Session cookies are then sent only over HTTPS.
COOKIE_SECURE=false
# true when running behind a reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For.
TRUST_PROXY=false

# First administrator, created on start if the email does not exist yet. Change the password after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Staging/review only: skip the email confirmation step for new accounts.
AUTO_VERIFY_EMAIL=false
# Learners may change category once per 30 days (false = any time).
CATEGORY_CHANGE_LIMIT=true

# outbox = store emails in the mail_outbox table (admin panel → Poçt); console = also print them (local dev only).
MAIL_MODE=outbox

# Built web app served by the API server (production). Leave empty in development (Vite serves it).
WEB_DIST=
# Content bundle imported on first start when the database has no content yet.
CONTENT_SEED=
