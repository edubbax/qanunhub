{
  "name": "@qanunhub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:hono --external:@hono/node-server --external:postgres --external:zod",
    "migrate": "tsx src/cli.ts migrate",
    "import": "tsx src/cli.ts import ../../content/build/content.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@qanunhub/core": "0.1.0",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
