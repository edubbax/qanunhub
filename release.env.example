# QanunHub on one computer: copy to release.env (or edit release/.env) and fill in.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase -> Connect -> Transaction pooler, user qanunhub_api.<project-ref> (supabase/api-role.sql).
# Several comma-separated URLs may be given; the first that connects is used.
DATABASE_URL_CANDIDATES=postgres://qanunhub_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase's default Site URL is http://localhost:3000, so e-mail links come back here.
PORT=3000
# This account becomes admin on its first sign-in.
ADMIN_EMAIL=
